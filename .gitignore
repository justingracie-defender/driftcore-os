# DriftCore .gitignore

# Admin credentials — NEVER commit these
_config/
_config/.driftcore/
_config/.driftcore/admin.json

# Runtime logs — generated during operation
logs/
data/

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
venv/
env/
.env/
.venv/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Test artifacts
.pytest_cache/
.coverage
htmlcov/

# Node (for doc generation)
node_modules/

# Root-level runtime state (regenerated each run; must not be committed)
driftcore_daily_budget.json
driftcore_spent_tokens.json
*_spent_tokens.json
*_daily_budget.json
*.jsonl

# Safety artifacts — DO NOT ignore; these are load-bearing baselines, not runtime state
!scripts/robot_surface_baseline.json
