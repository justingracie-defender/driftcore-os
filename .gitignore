# DriftCore .gitignore

# Admin credentials — NEVER commit these
_config/
_config/.driftcore/
_config/.driftcore/admin.json

# Runtime logs — generated during operation
logs/
data/

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
venv/
env/
.env/
.venv/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Test artifacts
.pytest_cache/
.coverage
htmlcov/

# Node (for doc generation)
node_modules/

# Root-level runtime state (regenerated each run; must not be committed)
driftcore_daily_budget.json
driftcore_spent_tokens.json
*_spent_tokens.json
*_daily_budget.json
*.jsonl

# EXCEPTION (2026-09-22): the blanket *.jsonl above silently swallowed the raw
# experimental records. This is why the v1 marshmallow trial data has no artifact
# behind it and why the predictability pilot's events.jsonl survived only inside a
# separate review zip. A result with no retained data is not a result — keep these.
!marshmallow/trials.jsonl
!marshmallow/**/trials.jsonl
!predictability/events.jsonl
!predictability/**/*.jsonl
!verification/**/*.jsonl
